# Dépendances matérielles (YDLidar, Scout, ZED)

repositories:
  dependencies/ydlidar_ros2_ws:
    type: git
    url: https://github.com/YDLIDAR/ydlidar_ros2_driver.git
    version: humble
  dependencies/scout_base:
    type: git
    url: https://github.com/agilexrobotics/scout_ros2.git
    version: main
  dependencies/zed-ros2-wrapper:
    type: git
    url: https://github.com/stereolabs/zed-ros2-wrapper.git
    version: humble
