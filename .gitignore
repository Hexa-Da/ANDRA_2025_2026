# ROS2 build files
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros2_ws/src/build/
ros2_ws/src/install/
ros2_ws/src/log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class

# Images et vidéos générées (trop volumineuses)
ros2_ws/images_detectees/
ros2_ws/images_capturees/
ros2_ws/images_capturees_techlab/
video/video_output/

# Image disque robot (conservation du .sha256 dans backup/ uniquement)
backup/*.img.zst

# Note: Les cartes .pgm sont importantes, on les garde
# Si vous voulez les ignorer, décommentez la ligne suivante :
# ros2_ws/src/ros_launcher/map_results/*.pgm

# Modèles YOLO (trop volumineux)
*.pt
*.pth
*.onnx
*.engine
ros2_ws/models/

# Images générées par report_fissures
map_with_point_*.png
map_with_points_*.png
ros2_ws/map_detections/

# Fichiers temporaires
*.swp
*.swo
*~
.DS_Store
*.bak
*.tmp

# IDEs
.vscode/
.idea/
*.code-workspace

# Docker images et build artifacts 
*.tar
docker/*.tar
*.dockerignore.bak
docker/build/
docker/log/

# Dossiers de compilation
/build
/install
/log

# Dependance des capteurs
dependencies/ydlidar_ros2_ws/
dependencies/scout_base/
dependencies/zed-ros2-wrapper/